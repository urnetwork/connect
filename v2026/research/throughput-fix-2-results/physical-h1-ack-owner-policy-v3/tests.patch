+// The provider is a child of the client, matching production lifetime
+// ownership. Provider.Close must never cancel the independently live client.
+package connect
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/urnetwork/connect/protocol"
+)
+
+// Only the unused NAT ingress is paused; return workers use real provider
+// admission with a provider context derived before any worker is started.
+func newProviderPureAckClientFixture(t *testing.T, providerSettings *RemoteUserNatProviderSettings, clientSettings *ClientSettings) (*RemoteUserNatProvider, *Client) {
+	t.Helper()
+	clientCtx, clientCancel := context.WithCancel(context.Background())
+	client := NewClient(clientCtx, NewId(), NewNoContractClientOob(), clientSettings)
+	providerCtx, providerCancel := context.WithCancel(clientCtx)
+	localUserNat := &LocalUserNat{ctx: providerCtx, sendPackets: make(chan *SendPacket, 1)}
+	provider := &RemoteUserNatProvider{
+		ctx: providerCtx, client: client, cancel: providerCancel, localUserNat: localUserNat,
+		securityPolicy: providerSettings.SecurityPolicyGenerator(providerCtx, DefaultSecurityPolicyStatsCollector()),
+		settings:       providerSettings, packetStatsCounters: &packetStatsCounters{},
+		packetStatsCallbacks: NewCallbackList[PacketStatsFunction](),
+		sourceProvideMode:    map[Id]protocol.ProvideMode{}, sourceP2pPriorityRefresh: map[Id]time.Time{},
+	}
+	provider.startReturnSenders()
+	t.Cleanup(func() { provider.Close(); clientCancel(); client.Cancel() })
+	return provider, client
+}
