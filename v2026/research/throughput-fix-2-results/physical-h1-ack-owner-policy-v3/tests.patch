+// Dedicated ACK ownership stays bounded by the existing flow worker and
+// ends at flow/provider cancellation without changing shared callback policy.
+package connect
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+
+	"github.com/urnetwork/connect/protocol"
+)
+
+// Cancelling only the TCP flow must release the held control and join its
+// owner while the provider and its two occupied Transfer slots remain live.
+func TestWindowPhysicalH1ProviderPureAckFlowCancelReleasesOwner(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		var witness []byte
+		stopped := make(chan struct{})
+		fixture.tcp.sequence.afterPureAckBuildForTest = func(packet []byte) { witness = MessagePoolShareReadOnly(packet) }
+		fixture.tcp.sequence.afterPureAckWorkerStopForTest = func() { close(stopped) }
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq, "x", false)
+		fixture.tcp.readPayload("x")
+		synctest.Wait()
+		if witness == nil {
+			t.Fatal("the actual ACK worker never built its control")
+		}
+		fixture.tcp.sequence.Cancel()
+		synctest.Wait()
+		select {
+		case <-stopped:
+		default:
+			t.Error("flow cancellation did not release its own pending ACK worker")
+		}
+		if providerPureAckCurrentLane(fixture) != fixture.sequence {
+			t.Error("flow-only cancellation retired the shared Transfer lane")
+		}
+		if fixture.provider.ctx.Err() != nil || len(fixture.sequence.packs) != 2 {
+			t.Error("flow cancellation changed provider or existing Transfer ownership")
+		}
+		if !MessagePoolReturn(witness) {
+			t.Error("flow cancellation left the pending ACK owned outside its witness")
+		}
+		fixture.releasePacks()
+		synctest.Wait()
+		if len(fixture.sequence.packs) != 0 {
+			t.Error("canceled flow published its old ACK when capacity returned")
+		}
+	})
+}
+
+// Provider shutdown joins the same fixed sender admission without requiring
+// a send-buffer slot or cancelling unrelated client state first.
+func TestWindowPhysicalH1ProviderPureAckProviderCancelReleasesOwner(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		var witness []byte
+		fixture.tcp.sequence.afterPureAckBuildForTest = func(packet []byte) { witness = MessagePoolShareReadOnly(packet) }
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq, "x", false)
+		fixture.tcp.readPayload("x")
+		synctest.Wait()
+		if witness == nil {
+			t.Fatal("the actual ACK worker never built its control")
+		}
+		fixture.provider.Close()
+		synctest.Wait()
+		if fixture.client.ctx.Err() != nil || len(fixture.sequence.packs) != 2 {
+			t.Error("provider close used client cancellation or changed admitted slots")
+		}
+		if !MessagePoolReturn(witness) {
+			t.Error("provider cancellation retained the pending ACK")
+		}
+		fixture.releasePacks()
+		synctest.Wait()
+		if len(fixture.sequence.packs) != 0 {
+			t.Error("closed provider published its old ACK after capacity returned")
+		}
+	})
+}
+
+// New upload progress while the sole ACK owner is parked must eventually
+// cover the latest cumulative head. Both latest-only coalescing and an older
+// ACK followed by the latest are valid; neither may grow a pending queue or
+// extend the normal Transfer acknowledgement lifetime.
+func TestWindowPhysicalH1ProviderPureAckAdvancesAfterHeldControl(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		var built atomic.Int64
+		fixture.tcp.sequence.afterPureAckBuildForTest = func([]byte) { built.Add(1) }
+		started, release := make(chan struct{}), make(chan struct{})
+		var first sync.Once
+		fixture.provider.returnSendStarted = func() { first.Do(func() { close(started); <-release }) }
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq, "x", false)
+		fixture.tcp.readPayload("x")
+		<-started
+		close(release)
+		synctest.Wait()
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq+1, "y", false)
+		fixture.tcp.readPayload("y")
+		synctest.Wait()
+		if len(fixture.sequence.packs) != 2 || fixture.sequence.packAdmission.count != 2 {
+			t.Error("waiting controls exceeded the existing two-slot admission bound")
+		}
+		fixture.releaseOne()
+		synctest.Wait()
+		firstAcks := fixture.deliveredAcks(t)
+		synctest.Wait()
+		secondAcks := fixture.deliveredAcks(t)
+		acks := append(firstAcks, secondAcks...)
+		latest := fixture.tcp.nextSeq + 2
+		if len(acks) == 0 || len(acks) > 2 || acks[len(acks)-1] != latest {
+			t.Errorf("released admission did not cover the latest cumulative head: %v", acks)
+		}
+		for index, head := range acks {
+			if head < fixture.tcp.nextSeq+1 || latest < head || 0 < index && head <= acks[index-1] {
+				t.Errorf("ACK heads must advance without duplicate ownership: %v", acks)
+			}
+		}
+		if fixture.provider.CongestionDropStats() != (ProviderCongestionDrops{}) {
+			t.Errorf("owned cumulative coverage was refused: built=%d drops=%+v", built.Load(), fixture.provider.CongestionDropStats())
+		}
+		if fixture.sequence.packAdmission.count != 0 {
+			t.Error("control admission retained a slot after final consumption")
+		}
+	})
+}
+
+// An orphan/shared synthesized control has no dedicated worker capability.
+// It retains the same zero-wait refusal even though a peer can regenerate it.
+func TestWindowPhysicalH1ProviderSharedRegenerableAckStillRefuses(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		fixture.tcp.sequence.mutex.Lock()
+		packet, err := fixture.tcp.sequence.PureAck()
+		fixture.tcp.sequence.mutex.Unlock()
+		if err != nil {
+			t.Fatal(err)
+		}
+		fixture.provider.receiveTransferWithRecovery(fixture.tcp.source, TransferKey{}, protocol.ProvideMode_Network, receiveRecoveryModeRegenerableControl, fixture.tcp.sequence.IpPath(), packet)
+		MessagePoolReturn(packet)
+		synctest.Wait()
+		drops := fixture.provider.CongestionDropStats()
+		if drops.ReturnSendPacketCount != 1 || drops.ReturnSendByteCount != 52 || drops.ReturnQueuePacketCount != 0 {
+			t.Fatalf("shared regenerable control changed its terminal zero-wait disposition: %+v", drops)
+		}
+		fixture.releasePacks()
+		synctest.Wait()
+		if len(fixture.sequence.packs) != 0 {
+			t.Fatal("shared regenerable control retried after refusal")
+		}
+	})
+}
+
+// A failed zero-timeout attempt may enter the existing paced retry boundary.
+// Canceling there must stop the exact flow without retiring accepted siblings.
+func TestWindowPhysicalH1ProviderPureAckCancelAtRetryKeepsSiblings(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		fixture.provider.settings.WriteTimeout = 0
+		var witness []byte
+		fixture.tcp.sequence.afterPureAckBuildForTest = func(packet []byte) { witness = MessagePoolShareReadOnly(packet) }
+		entered, release := make(chan struct{}), make(chan struct{})
+		var first sync.Once
+		fixture.provider.beforeTcpReturnSendRetryForTest = func() { first.Do(func() { close(entered); <-release }) }
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq, "x", false)
+		fixture.tcp.readPayload("x")
+		synctest.Wait()
+		select {
+		case <-entered:
+		default:
+			t.Error("owned ACK was discarded instead of reaching its cancellable retry boundary")
+		}
+		fixture.tcp.sequence.Cancel()
+		close(release)
+		synctest.Wait()
+		if witness == nil {
+			t.Fatal("the worker never built its pure ACK")
+		}
+		if !MessagePoolReturn(witness) {
+			t.Error("retry-boundary cancellation retained a pooled ACK owner")
+		}
+		if providerPureAckCurrentLane(fixture) != fixture.sequence || len(fixture.sequence.packs) != 2 {
+			t.Error("retry-boundary cancellation retired accepted siblings")
+		}
+		fixture.releasePacks()
+		synctest.Wait()
+		if len(fixture.sequence.packs) != 0 {
+			t.Error("canceled retry delivered its old ACK when capacity returned")
+		}
+	})
+}
+
+// Cancellation between provider ownership registration and its first send
+// must finish without creating a waiting context or retrying on source life.
+func TestWindowPhysicalH1ProviderPureAckCancelBeforeAttemptStopsOwner(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		var witness []byte
+		stopped := make(chan struct{})
+		fixture.tcp.sequence.afterPureAckBuildForTest = func(packet []byte) { witness = MessagePoolShareReadOnly(packet) }
+		fixture.tcp.sequence.afterPureAckWorkerStopForTest = func() { close(stopped) }
+		fixture.provider.returnSendStarted = func() { fixture.tcp.sequence.Cancel() }
+		fixture.tcp.sendPayload(fixture.tcp.nextSeq, "x", false)
+		fixture.tcp.readPayload("x")
+		synctest.Wait()
+		select {
+		case <-stopped:
+		default:
+			t.Error("pre-attempt flow cancellation left its ACK worker retrying")
+		}
+		if witness == nil {
+			t.Fatal("the worker never built its pure ACK")
+		}
+		if !MessagePoolReturn(witness) {
+			t.Error("pre-attempt cancellation retained a pooled ACK owner")
+		}
+		if providerPureAckCurrentLane(fixture) != fixture.sequence || len(fixture.sequence.packs) != 2 {
+			t.Error("pre-attempt cancellation retired accepted siblings")
+		}
+	})
+}
