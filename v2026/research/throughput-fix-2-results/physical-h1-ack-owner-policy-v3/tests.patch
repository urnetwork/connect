+// Caller cancellation owns only that caller's unadmitted Pack. It must not
+// retire a shared lane or reclaim already-accepted sibling ownership.
+package connect
+
+import (
+	"context"
+	"testing"
+	"testing/synctest"
+
+	"github.com/urnetwork/connect/protocol"
+)
+
+// Read the same exact id used by real provider return admission.
+func providerPureAckCurrentLane(fixture *providerPureAckAdmissionFixture) *SendSequence {
+	fixture.client.sendBuffer.mutex.Lock()
+	defer fixture.client.sendBuffer.mutex.Unlock()
+	return fixture.client.sendBuffer.sendSequences[fixture.sequence.id()]
+}
+
+// A canceled caller is stopped before admission; its two live siblings keep
+// the original shared sequence and retained bytes.
+func TestSendBufferCallerCancelPreservesSharedAdmission(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		bytes := MessagePoolCopy([]byte("unadmitted-caller"))
+		pack := &SendPack{TransferOptions: TransferOptions{Ack: true}, Frame: &protocol.Frame{MessageBytes: bytes}, Destination: fixture.sequence.destination, EncryptionRole: fixture.sequence.encryptionRole, Ctx: ctx, logicalLane: fixture.sequence.logicalLane, logicalLaneExplicit: true}
+		accepted, err := fixture.client.sendBuffer.Pack(pack, 0)
+		if !accepted {
+			MessagePoolReturn(bytes)
+		}
+		if accepted || err == nil {
+			t.Errorf("canceled caller admission=%t error=%v", accepted, err)
+		}
+		if providerPureAckCurrentLane(fixture) != fixture.sequence || fixture.sequence.ctx.Err() != nil {
+			t.Error("a canceled unadmitted caller retired its shared sequence")
+		}
+		if len(fixture.sequence.packs) != 2 || fixture.sequence.packAdmission.count != 2 {
+			t.Error("canceled caller changed sibling admission ownership")
+		}
+	})
+}
+
+// Cancellation during the actual count-capacity wait must return the same
+// failure without treating the healthy lane as a closed generation.
+func TestSendBufferCallerCancelDuringAdmissionKeepsSiblings(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		fixture.fill(t, 2)
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		bytes := MessagePoolCopy([]byte("blocked-caller"))
+		pack := &SendPack{TransferOptions: TransferOptions{Ack: true}, Frame: &protocol.Frame{MessageBytes: bytes}, Destination: fixture.sequence.destination, EncryptionRole: fixture.sequence.encryptionRole, Ctx: ctx, logicalLane: fixture.sequence.logicalLane, logicalLaneExplicit: true}
+		type result struct {
+			accepted bool
+			err      error
+		}
+		done := make(chan result, 1)
+		go func() {
+			accepted, err := fixture.client.sendBuffer.Pack(pack, -1)
+			done <- result{accepted: accepted, err: err}
+		}()
+		synctest.Wait()
+		select {
+		case <-done:
+			t.Fatal("the full two-slot lane did not retain the caller outside admission")
+		default:
+		}
+		cancel()
+		got := <-done
+		if !got.accepted {
+			MessagePoolReturn(bytes)
+		}
+		if got.accepted || got.err == nil {
+			t.Errorf("canceled blocked admission=%t error=%v", got.accepted, got.err)
+		}
+		if providerPureAckCurrentLane(fixture) != fixture.sequence || len(fixture.sequence.packs) != 2 {
+			t.Error("cancellation after a capacity wait retired sibling ownership")
+		}
+	})
+}
+
+// A successful send has already transferred ownership, even if that caller
+// cancels before its next send. Failure of the next Pack cannot reclaim it.
+func TestSendBufferCallerCancelKeepsAcceptedPackOwned(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		fixture := newProviderPureAckAdmissionFixture(t, WindowSizingConstant)
+		ctx, cancel := context.WithCancel(context.Background())
+		firstBytes := MessagePoolCopy([]byte("accepted-caller"))
+		first := &SendPack{TransferOptions: TransferOptions{Ack: true}, Frame: &protocol.Frame{MessageBytes: firstBytes}, Destination: fixture.sequence.destination, EncryptionRole: fixture.sequence.encryptionRole, Ctx: ctx, logicalLane: fixture.sequence.logicalLane, logicalLaneExplicit: true}
+		if accepted, err := fixture.client.sendBuffer.Pack(first, 0); !accepted || err != nil {
+			MessagePoolReturn(firstBytes)
+			t.Fatalf("first caller was not admitted: %t %v", accepted, err)
+		}
+		cancel()
+		nextBytes := MessagePoolCopy([]byte("canceled-next"))
+		next := &SendPack{TransferOptions: TransferOptions{Ack: true}, Frame: &protocol.Frame{MessageBytes: nextBytes}, Destination: fixture.sequence.destination, EncryptionRole: fixture.sequence.encryptionRole, Ctx: ctx, logicalLane: fixture.sequence.logicalLane, logicalLaneExplicit: true}
+		accepted, err := fixture.client.sendBuffer.Pack(next, 0)
+		if !accepted {
+			MessagePoolReturn(nextBytes)
+		}
+		if accepted || err == nil || providerPureAckCurrentLane(fixture) != fixture.sequence {
+			t.Error("the canceled next send retired its accepted predecessor's lane")
+		}
+		select {
+		case owned := <-fixture.sequence.packs:
+			if owned != first || string(owned.Frame.MessageBytes) != "accepted-caller" {
+				t.Error("accepted Pack ownership or bytes changed")
+			}
+			owned.returnFrames()
+			owned.releaseRaw()
+		default:
+			t.Error("accepted Pack was reclaimed before its consumer took it")
+		}
+	})
+}
+
+// A real sequence closure is still a generation failure. A live caller must
+// recreate and admit through the replacement, preserving existing semantics.
+func TestSendBufferClosedSequenceStillRecreatesForLiveCaller(t *testing.T) {
+	assertMessagePoolOwnership(t)
+	MessagePoolReturn(MessagePoolGet(1))
+	synctest.Test(t, func(t *testing.T) {
+		releaseWorker := make(chan struct{})
+		defer close(releaseWorker)
+		fixture := newProviderPureAckAdmissionFixtureWithSetup(t, WindowSizingConstant, func(settings *ClientSettings) {
+			settings.SendBufferSettings.beforeRunSendSequenceForTest = func(id sendSequenceId) {
+				if id.Destination != ControlId {
+					<-releaseWorker
+				}
+			}
+		})
+		closed, cancel := context.WithCancel(fixture.provider.ctx)
+		cancel()
+		fixture.sequence.ctx = closed
+		// The immutable constructor hook parks only data workers. Admission
+		// remains the real SendBuffer/SendSequence path and unchanged channel.
+		bytes := MessagePoolCopy([]byte("replacement-caller"))
+		pack := &SendPack{TransferOptions: TransferOptions{Ack: true}, Frame: &protocol.Frame{MessageBytes: bytes}, Destination: fixture.sequence.destination, EncryptionRole: fixture.sequence.encryptionRole, Ctx: fixture.provider.ctx, logicalLane: fixture.sequence.logicalLane, logicalLaneExplicit: true}
+		accepted, err := fixture.client.sendBuffer.Pack(pack, 0)
+		replacement := providerPureAckCurrentLane(fixture)
+		if !accepted || err != nil {
+			MessagePoolReturn(bytes)
+			t.Fatalf("live caller did not recreate closed sequence: %t %v", accepted, err)
+		}
+		if replacement == nil || replacement == fixture.sequence {
+			t.Fatal("closed sequence was retained")
+		}
+		owned := <-replacement.packs
+		if owned != pack {
+			t.Error("replacement admitted different Pack ownership")
+		}
+		owned.returnFrames()
+		owned.releaseRaw()
+	})
+}
