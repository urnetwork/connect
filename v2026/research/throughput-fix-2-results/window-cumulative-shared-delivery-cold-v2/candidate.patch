+// Shared delivery history retains exact credited bytes across short drained
+// trains. Raw arrival rates are policy observations; offer-to-ack rates are
+// conservative lower bounds. Neither requires destination ingress ordering.
+package connect
+
+import (
+	"math"
+	"time"
+)
+
+// All clocks are local sender clocks. Every byte belongs to one confirmed
+// initial H1 write; unknown or copied offers make a selected interval unusable.
+// The first raw checkpoint's entire tied group is excluded from arrival rates.
+type windowServiceDeliverySample struct {
+	bucket           int64
+	bytes            ByteCount
+	firstBytes       ByteCount
+	firstAtNanos     int64
+	lastAtNanos      int64
+	firstSentAtNanos int64
+	eligible         bool
+}
+
+// Merging preserves original endpoints and the earliest offer, including an
+// unknown zero offer. Rebinning cannot move credited bytes onto a newer clock.
+func (self *windowServiceDeliverySample) add(other windowServiceDeliverySample) {
+	if other.bytes <= 0 {
+		return
+	}
+	if self.bytes == 0 {
+		bucket := self.bucket
+		*self = other
+		self.bucket = bucket
+		return
+	}
+	if other.firstAtNanos < self.firstAtNanos {
+		self.firstAtNanos, self.firstBytes = other.firstAtNanos, other.firstBytes
+	} else if other.firstAtNanos == self.firstAtNanos {
+		self.firstBytes += other.firstBytes
+	}
+	self.lastAtNanos = max(self.lastAtNanos, other.lastAtNanos)
+	self.firstSentAtNanos = min(self.firstSentAtNanos, other.firstSentAtNanos)
+	self.bytes += other.bytes
+	self.eligible = self.eligible && other.eligible
+}
+
+// One fixed ring retains at least two current residences. A cold serializer's
+// train boundaries do not erase this separate cumulative delivery history.
+// The owning service's state lock protects insertion, resizing and reads.
+type windowServiceDeliveryRing struct {
+	samples      [deliveredBytesRingSize]windowServiceDeliverySample
+	interval     time.Duration
+	newestBucket int64
+	hasSamples   bool
+}
+
+// Old modulo slots cannot overwrite recent credit, including the exact
+// eviction boundary. Original timestamps survive any bucket-width change.
+func (self *windowServiceDeliveryRing) insert(sample windowServiceDeliverySample) {
+	interval := max(deliverySizedWindowSampleInterval, self.interval)
+	bucket := sample.lastAtNanos / int64(interval)
+	if self.hasSamples && bucket <= self.newestBucket-int64(len(self.samples)) {
+		return
+	}
+	if !self.hasSamples || self.newestBucket < bucket {
+		self.newestBucket, self.hasSamples = bucket, true
+	}
+	index := (bucket%int64(len(self.samples)) + int64(len(self.samples))) % int64(len(self.samples))
+	destination := &self.samples[index]
+	if destination.bytes == 0 || destination.bucket != bucket {
+		*destination = windowServiceDeliverySample{bucket: bucket}
+	}
+	destination.add(sample)
+}
+
+// A larger RTT changes retention, not the actual interval represented by any
+// credited byte. Shrinking the ring discards only complete retired aggregates.
+func (self *windowServiceDeliveryRing) resize(interval time.Duration) {
+	interval = max(deliverySizedWindowSampleInterval, interval)
+	if interval == max(deliverySizedWindowSampleInterval, self.interval) {
+		return
+	}
+	previous, newest := self.samples, self.newestBucket
+	clear(self.samples[:])
+	self.newestBucket, self.hasSamples, self.interval = 0, false, interval
+	for offset := int64(0); offset < int64(len(previous)); offset++ {
+		bucket := newest - offset
+		index := (bucket%int64(len(previous)) + int64(len(previous))) % int64(len(previous))
+		sample := previous[index]
+		if sample.bytes > 0 && sample.bucket == bucket {
+			self.insert(sample)
+		}
+	}
+}
+
+// Factual endpoints accompany the two differently qualified observations.
+// Arrival rate excludes the first completion; the offer bound includes every
+// byte because all of its writes begin at or after that interval's origin.
+type windowServiceDeliveryEstimate struct {
+	bytes            ByteCount
+	firstBytes       ByteCount
+	firstAtNanos     int64
+	lastAtNanos      int64
+	firstSentAtNanos int64
+	arrivalByteRate  ByteCount
+	offerByteRate    ByteCount
+}
+
+// Saturation keeps a valid long residence from wrapping into a short history.
+func windowServiceDeliveryMinimumSpan(residence time.Duration) time.Duration {
+	if residence > time.Duration(math.MaxInt64/2) {
+		return time.Duration(math.MaxInt64)
+	}
+	return 2 * max(0, residence)
+}
+
+// Byte counts and clocks remain exact; only the final rate conversion rounds.
+func windowServiceDeliveryByteRate(bytes ByteCount, span int64) ByteCount {
+	if bytes <= 0 || span <= 0 {
+		return 0
+	}
+	rate := float64(bytes) * float64(time.Second) / float64(span)
+	if rate >= float64(math.MaxInt64) {
+		return ByteCount(math.MaxInt64)
+	}
+	return ByteCount(rate)
+}
+
+// The newest complete interval is used for ordinary policy reads. A warm
+// offer bound may explicitly inspect all retained history, without retaining
+// that bound as a permanent high-water measurement.
+func (self *windowServiceDeliveryRing) estimate(at time.Time, minimumSpan time.Duration, afterNanos int64, all bool) windowServiceDeliveryEstimate {
+	interval := max(deliverySizedWindowSampleInterval, self.interval)
+	minimumSpan = max(minimumSpan, 4*interval)
+	horizon := time.Duration(math.MaxInt64)
+	if interval <= time.Duration(math.MaxInt64/int64(len(self.samples))) {
+		horizon = interval * time.Duration(len(self.samples))
+	}
+	selected := windowServiceDeliverySample{}
+	for offset := int64(0); offset < int64(len(self.samples)); offset++ {
+		bucket := self.newestBucket - offset
+		index := (bucket%int64(len(self.samples)) + int64(len(self.samples))) % int64(len(self.samples))
+		sample := self.samples[index]
+		if sample.bytes <= 0 || sample.bucket != bucket || sample.lastAtNanos > at.UnixNano() ||
+			sample.firstAtNanos < afterNanos || sample.lastAtNanos < at.Add(-horizon).UnixNano() {
+			continue
+		}
+		selected.add(sample)
+		if !all && selected.lastAtNanos-selected.firstAtNanos >= int64(minimumSpan) {
+			break
+		}
+	}
+	if !selected.eligible || selected.bytes <= selected.firstBytes || selected.firstSentAtNanos <= 0 ||
+		selected.firstSentAtNanos < afterNanos || selected.firstSentAtNanos > selected.firstAtNanos ||
+		selected.lastAtNanos-selected.firstAtNanos < int64(minimumSpan) ||
+		at.UnixNano()-selected.lastAtNanos > int64(minimumSpan) {
+		return windowServiceDeliveryEstimate{}
+	}
+	return windowServiceDeliveryEstimate{
+		bytes: selected.bytes, firstBytes: selected.firstBytes,
+		firstAtNanos: selected.firstAtNanos, lastAtNanos: selected.lastAtNanos,
+		firstSentAtNanos: selected.firstSentAtNanos,
+		arrivalByteRate:  windowServiceDeliveryByteRate(selected.bytes-selected.firstBytes, selected.lastAtNanos-selected.firstAtNanos),
+		offerByteRate:    windowServiceDeliveryByteRate(selected.bytes, selected.lastAtNanos-selected.firstSentAtNanos),
+	}
+}
+
+// Exact once-only credit reaches this history before serialization epochs can
+// discard its older arrival. Pending, copied and non-H1 writes stay explicit.
+func (self *windowPacingService) observeAggregateDeliveryWithLock(credit windowServiceAckCredit, at time.Time) {
+	if credit.bytes <= 0 {
+		return
+	}
+	timingAt := at
+	if self.lastRoundTrip.After(timingAt) {
+		timingAt = self.lastRoundTrip
+	}
+	residence := self.roundTripEvidenceWithLock(timingAt).residence
+	span := windowServiceDeliveryMinimumSpan(residence)
+	slots := time.Duration(len(self.aggregate.samples) - 2)
+	interval := span / slots
+	if span%slots != 0 {
+		interval++
+	}
+	self.aggregate.resize(max(deliverySizedWindowSampleInterval, interval))
+	self.aggregate.insert(windowServiceDeliverySample{
+		bytes: credit.bytes, firstBytes: credit.bytes, firstAtNanos: at.UnixNano(), lastAtNanos: at.UnixNano(),
+		firstSentAtNanos: credit.firstSentAtNanos,
+		eligible:         credit.receiverTimingEligible && credit.firstSentAtNanos > 0 && credit.firstSentAtNanos <= at.UnixNano(),
+	})
+}
+
+// The shared policy reader uses its current permission cutoff. It cannot
+// borrow another service or an interval from before a proved path change.
+func (self *windowPacingService) aggregateDelivery(at time.Time, minimumSpan time.Duration, afterNanos int64) windowServiceDeliveryEstimate {
+	self.stateLock.Lock()
+	defer self.stateLock.Unlock()
+	return self.aggregateDeliveryWithLock(at, minimumSpan, afterNanos)
+}
+
+// Match cumulative qualification over several feedback turns; stats reads
+// use the same facts without changing history or accepted service.
+func (self *windowPacingService) aggregateDeliveryWithLock(at time.Time, minimumSpan time.Duration, afterNanos int64) windowServiceDeliveryEstimate {
+	minimumSpan = max(minimumSpan, windowServiceDeliveryMinimumSpan(self.roundTripEvidenceWithLock(at).residence))
+	return self.aggregate.estimate(at, minimumSpan, max(afterNanos, self.windowDeliveryAfterNanos), false)
+}
+
+// An established service can be raised by wholly newer physical offers.
+// All retained credit makes this lower bound useful despite propagation;
+// the finite ring still expires old fast delivery after genuine slowdown.
+func (self *windowPacingService) aggregateOfferedDeliveryWithLock(at time.Time) windowServiceDeliveryEstimate {
+	afterNanos := self.windowDeliveryAfterNanos
+	if !self.serviceEpochAt.IsZero() {
+		afterNanos = max(afterNanos, self.serviceEpochAt.UnixNano())
+	}
+	if probe := self.roundTripProbe; probe.resetService {
+		afterNanos = max(afterNanos, probe.sentAt.UnixNano())
+	}
+	minimumSpan := windowServiceDeliveryMinimumSpan(self.roundTripEvidenceWithLock(at).residence)
+	return self.aggregate.estimate(at, minimumSpan, afterNanos, true)
+}
