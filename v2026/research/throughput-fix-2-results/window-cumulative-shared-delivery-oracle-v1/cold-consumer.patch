@@ -0,0 +1,29 @@
+// Shared pacing consumes a service-wide rate even when its logical senders
+// retain separate cumulative sizing histories. This reader never learns bytes.
+package connect
+
+import "time"
+
+// Current H1 evidence may guide every early-return path with pacing enabled.
+// Serialization stays authoritative; missing aggregate history keeps the own
+// cumulative fallback. Snapshot reads do not mutate either measurement owner.
+func (self *SendSequence) finalizeWindowPacing(at time.Time, estimate *SendWindowEstimate) {
+	if estimate.PacingProbeByteRate <= 0 {
+		return
+	}
+	if service := self.windowPacer.service; service != nil && self.transferFlightPolicy().h1Only {
+		residence := estimate.WindowRoundTrip
+		if residence <= 0 {
+			residence = service.roundTripEvidence(at).residence
+		}
+		if residence > 0 {
+			minimumSpan := max(windowServiceDeliveryMinimumSpan(residence), 4*self.deliveredBytesSampleIntervalAt(at))
+			afterNanos := max(self.receiveWindowSetAtNanos.Load(), service.windowDeliveryStep())
+			delivery := service.aggregateDelivery(at, minimumSpan, afterNanos)
+			if delivery.arrivalByteRate > 0 && min(estimate.Initial, kib(4)) <= delivery.bytes-delivery.firstBytes {
+				estimate.AggregateDeliveryByteRate = delivery.arrivalByteRate
+			}
+		}
+	}
+	estimate.PacingByteRate = windowPacingRate(*estimate, estimate.PacingProbeByteRate)
+}
