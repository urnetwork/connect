+// Bounded delivery aggregates retain raw arrival ownership and the receiver
+// clock attached to those same endpoints. Ambiguous order grants no new rate.
+package connect
+
+// Merge exact raw endpoints without sorting bytes onto a different clock.
+// Overlapping interiors cannot prove receiver order from bounded summaries.
+func (self *windowServiceSample) add(sample windowServiceSample) {
+	if sample.bytes <= 0 {
+		self.queued = self.queued || sample.queued
+		return
+	}
+	if self.bytes == 0 {
+		bucket, queued := self.bucket, self.queued
+		*self = sample
+		self.bucket = bucket
+		self.queued = self.queued || queued
+		return
+	}
+	self.receiverInvalid = self.receiverInvalid || sample.receiverInvalid
+	if self.receiverBytes == self.bytes && sample.receiverBytes == sample.bytes {
+		switch {
+		case sample.lastAtNanos < self.firstAtNanos:
+			self.receiverInvalid = self.receiverInvalid || sample.receiverLastAtNanos >= self.receiverFirstAtNanos
+		case self.lastAtNanos < sample.firstAtNanos:
+			self.receiverInvalid = self.receiverInvalid || self.receiverLastAtNanos >= sample.receiverFirstAtNanos
+		case sample.lastAtNanos == self.firstAtNanos:
+			self.receiverInvalid = self.receiverInvalid || sample.receiverLastAtNanos != self.receiverFirstAtNanos
+		case self.lastAtNanos == sample.firstAtNanos:
+			self.receiverInvalid = self.receiverInvalid || self.receiverLastAtNanos != sample.receiverFirstAtNanos
+		default:
+			self.receiverInvalid = true
+		}
+	}
+	if sample.firstAtNanos < self.firstAtNanos {
+		self.firstAtNanos, self.firstBytes = sample.firstAtNanos, sample.firstBytes
+		self.receiverFirstAtNanos = sample.receiverFirstAtNanos
+		self.firstQueued = sample.firstQueued
+	} else if sample.firstAtNanos == self.firstAtNanos {
+		self.firstBytes += sample.firstBytes
+		self.receiverFirstAtNanos = min(self.receiverFirstAtNanos, sample.receiverFirstAtNanos)
+		self.firstQueued = self.firstQueued || sample.firstQueued
+	}
+	if self.lastAtNanos < sample.lastAtNanos {
+		self.lastAtNanos = sample.lastAtNanos
+		self.receiverLastAtNanos = sample.receiverLastAtNanos
+		self.lastQueued = sample.lastQueued
+	} else if sample.lastAtNanos == self.lastAtNanos {
+		self.receiverLastAtNanos = max(self.receiverLastAtNanos, sample.receiverLastAtNanos)
+		self.lastQueued = self.lastQueued || sample.lastQueued
+	}
+	self.bytes += sample.bytes
+	self.receiverBytes += sample.receiverBytes
+	self.queued = self.queued || sample.queued
+}
+
+// A mixed or legacy aggregate retains its raw interval. A fully paired one
+// needs ordered positive receiver endpoints attached to its first-byte count.
+func (self windowServiceSample) deliverySpan() (int64, bool) {
+	span := self.lastAtNanos - self.firstAtNanos
+	if self.receiverBytes == self.bytes {
+		if self.receiverInvalid {
+			return 0, false
+		}
+		span = self.receiverLastAtNanos - self.receiverFirstAtNanos
+	}
+	return span, span > 0
+}
